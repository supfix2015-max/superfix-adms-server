APP_NAME=ADMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_LEVEL_DEVICES=debug

# SINGLE SQL Server database: original dbo.* tables and Laravel adms.*
# tables co-exist in Att2000_V4 without creating another database.
# The dedicated app SQL login MUST have DEFAULT_SCHEMA=adms and no rights on dbo.
DB_CONNECTION=sqlsrv
ADMS_SQLSRV_HOST=superfix-attendance-sql
ADMS_SQLSRV_PORT=1433
ADMS_SQLSRV_DATABASE=Att2000_V4
ADMS_SQLSRV_SCHEMA=adms
ADMS_SQLSRV_USERNAME=adms_v2_app
ADMS_SQLSRV_PASSWORD=
ADMS_SQLSRV_ENCRYPT=yes
ADMS_SQLSRV_TRUST_SERVER_CERTIFICATE=false

# Original historical records: strictly separate read-only SQL login.
# Use a private Docker network; never expose SQL Server 1433 to the Internet.
# Configure a SQL Server login with SELECT permissions only.
# Use a private network or VPN; never expose SQL Server 1433 to the Internet.
LEGACY_SQLSRV_HOST=
LEGACY_SQLSRV_PORT=1433
LEGACY_SQLSRV_DATABASE=Att2000_V4
LEGACY_SQLSRV_USERNAME=
LEGACY_SQLSRV_PASSWORD=
LEGACY_SQLSRV_ENCRYPT=yes
LEGACY_SQLSRV_TRUST_SERVER_CERTIFICATE=false
LEGACY_SQLSRV_BROWSER_ENABLED=false
# Keep off until a SQL Server INSERT readiness report, backup, and device pilot are approved.
LEGACY_SQLSRV_ATTENDANCE_WRITE_ENABLED=false
LEGACY_SQLSRV_ATTENDANCE_WRITE_SERIALS=
# OFF until a single-device pilot succeeded. Historical dbo.Device only;
# office UA300 never included by this flag.
LEGACY_SQLSRV_ATTENDANCE_WRITE_ALL_REGISTERED=false
# Explicit timezone matching the legacy SQL Server device-local VerifyTime convention.
LEGACY_SQLSRV_ATTENDANCE_TIMEZONE=
LEGACY_SQLSRV_WRITE_USERNAME=
LEGACY_SQLSRV_WRITE_PASSWORD=
LEGACY_SQLSRV_WRITE_TRUST_SERVER_CERTIFICATE=false
# Staging/testing default to no outbound commands even when devices poll.
ZKTECO_DISPATCH_COMMANDS=false
# Keep true while using temporary HTTP legacy serial-based receiving.
# Only authenticated terminals may receive operational commands.
ZKTECO_COMMAND_REQUIRE_TOKEN=true
# EXPLICIT narrow exception: unauthenticated HTTP PUSH CLOCK ONLY, no other
# commands or biometrics. Start with one serial and a short test window.
ZKTECO_LEGACY_TIME_ONLY_ENABLED=false
# Sync every existing Att2000_V4.dbo.Device registration + office UA300.
# Requires ADMS_PILOT_ENABLED=true and remains clock-only (other commands protected).
ZKTECO_LEGACY_TIME_ONLY_ALL_REGISTERED=false
# Use a serial-specific override only for an isolated pilot; leave blank for all-roster mode.
ZKTECO_LEGACY_TIME_ONLY_SERIALS=
ZKTECO_LEGACY_TIME_ONLY_INTERVAL_SECONDS=300
# Automatic periodic corrections via authenticated ADMS commands ONLY:
ZKTECO_AUTO_TIME_SYNC_ENABLED=false
ZKTECO_AUTO_TIME_SYNC_INTERVAL_HOURS=24
# UAE local clock; separate from UTC storage/log timestamps:
ZKTECO_SYSTEM_TIMEZONE=Asia/Dubai
ZKTECO_DEVICE_TIMEZONE=Asia/Dubai
ZKTECO_OPTION_TIMEZONE=+04:00
# Optional handshake hint, supported by some PUSH firmwares only.
ZKTECO_OPTION_SYNC_TIME_SECONDS=0

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@adms.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Device Authentication
DEVICE_API_TOKEN_ENABLED=true
DEVICE_API_TOKEN=your-secure-device-token-here
DEVICE_IP_WHITELIST=

# Feature Flags
FEATURE_DEVICE_ONLINE_TRACKING=true
FEATURE_MULTI_BRANCH=false
FEATURE_EXCEL_EXPORT=true

# ZKTeco ADMS
ZKTECO_AUTO_REGISTER_DEVICES=false
ZKTECO_REQUIRE_TOKEN=true
ZKTECO_TOKEN_QUERY_KEY=token
ZKTECO_ALLOWED_SERIALS=
ZKTECO_DEFAULT_DEVICE_PORT=8000
ZKTECO_DEVICE_ENDPOINTS=
ZKTECO_DEVICE_TIMEZONE=UTC
ZKTECO_OPTION_TIMEZONE=0
ZKTECO_OPTION_STAMP=9999
ZKTECO_OPTION_OPSTAMP=9999
ZKTECO_OPTION_ERROR_DELAY=60
ZKTECO_OPTION_DELAY=30
ZKTECO_OPTION_RES_LOG_DAY=18250
ZKTECO_OPTION_RES_LOG_DEL_COUNT=10000
ZKTECO_OPTION_RES_LOG_COUNT=50000
ZKTECO_OPTION_TRANS_TIMES=00:00;14:05
ZKTECO_OPTION_TRANS_INTERVAL=1
ZKTECO_OPTION_TRANS_FLAG=1111000000
ZKTECO_OPTION_REALTIME=true
ZKTECO_OPTION_ENCRYPT=false
ZKTECO_WEBHOOK_URL=
ZKTECO_WEBHOOK_SECRET=
ZKTECO_WEBHOOK_TIMEOUT=5

PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Superfix pilot safeguards. Never commit live credentials or templates.
ADMS_PILOT_ENABLED=false
# When true, accept original dbo.Device serials in addition to explicit ADMS_PILOT_SERIALS.
# Historical serial registration alone is NOT device authentication.
ADMS_ALLOW_HISTORICAL_DEVICES=false
ADMS_PILOT_SERIALS=
ADMS_PILOT_ALLOWED_IPS=
ADMS_SEED_DEMO_DATA=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ZKTECO_AUTO_PULL_EMPLOYEES_ON_CONTACT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
